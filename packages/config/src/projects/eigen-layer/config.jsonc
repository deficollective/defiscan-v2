    // ── External LST tokens ───────────────────────────────────────────────────
    "eth:0xE95A203B1a91a908F9B9CE46459d101078c2c3cb": {
      // Ankr Staked ETH (ankrETH)
      "ignoreRelatives": ["$admin", "$implementation", "owner"],
      "ignoreMethods": ["bondsToShares", "sharesToBonds"]
    },
    "eth:0xBe9895146f7AF43049ca1c1AE358B0541Ea49704": {
      // Coinbase Wrapped Staked ETH (cbETH)
      "ignoreRelatives": ["$admin", "$implementation", "admin", "blacklister", "implementation", "masterMinter", "oracle", "owner", "pauser", "rescuer"]
    },
    "eth:0x5E8422345238F34275888049021821E8E08CAa1f": {
      // Frax Ether (frxETH)
      "ignoreRelatives": ["minters_array", "nominatedOwner", "owner", "timelock_address"]
    },
    "eth:0x8c1BEd5b9a0928467c9B1341Da1D7BD5e10b6549": {
      // LsETH — Liquid Collective
      "ignoreRelatives": ["$admin", "$implementation", "getAdmin", "getAllowlist", "getCollector", "getCoverageFund", "getELFeeRecipient", "getKeeper", "getOperatorsRegistry", "getOracle", "getPendingAdmin", "getRedeemManager"],
