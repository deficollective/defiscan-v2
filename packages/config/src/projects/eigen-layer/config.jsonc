      "ignoreRelatives": ["$admin", "$implementation", "accounting", "accountingOracle", "burner", "coreComponents", "depositSecurityModule", "elRewardsVault", "lazyOracle", "lido", "operatorGrid", "oracleDaemonConfig", "oracleReportComponents", "oracleReportSanityChecker", "postTokenRebaseReceiver", "predepositGuarantee", "proxy__getAdmin", "proxy__getImplementation", "stakingRouter", "treasury", "triggerableWithdrawalsGateway", "validatorExitDelayVerifier", "validatorsExitBusOracle", "vaultFactory", "vaultHub", "withdrawalQueue", "withdrawalVault", "wstETH"]
